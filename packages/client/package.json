{
  "name": "@useapron/client",
  "version": "0.1.2",
  "description": "Typed HTTP client for the Apron gateway (/v1)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "clean": "rm -rf dist dist-test",
    "prepublishOnly": "npm run clean && npm test && npm run build"
  },


  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rouche01/computer-with-agent.git",
    "directory": "packages/client"
  },
  "keywords": [
    "useapron",
    "computer-use",
    "agent",
    "gateway",
    "desktop",
    "phone"
  ]
}

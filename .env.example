# Copy to .env and adjust. Used by docker compose.

COMPUTER_API_TOKEN=dev-token
GATEWAY_PUBLIC_BASE=http://localhost:9000

# Per-env worker inventory (must be an existing file — Compose mounts it read-only).
# Desktop-only (default):
WORKER_INVENTORY_FILE=./gateway/workers.json
# Desktop + phone seat (requires COMPOSE_PROFILES=phone):
# WORKER_INVENTORY_FILE=./gateway/workers.with-phone.json
# COMPOSE_PROFILES=phone
# ThinkPad / Caddy (.hsv HITL URLs):
#   cp gateway/workers.hsv.example.json gateway/workers.hsv.json
#   # edit vnc_url hostnames, then:
# WORKER_INVENTORY_FILE=./gateway/workers.hsv.json
# After up: curl -s -H "Authorization: Bearer $COMPUTER_API_TOKEN" http://localhost:9000/v1/seats | jq .

# Phone worker (profile "phone") — ADB must reach the device from this host (ThinkPad).
# ADB_SERIAL=R5CY53CAB6N
# ADB_CONNECT=192.168.1.20:5555
# Phone Watch (scrcpy-web on Compose profile phone → host :6083).
# Prefer /watch.html so lease vnc_url auto-selects ADB_SERIAL; / is the device picker.
# PHONE_HITL_URL=http://localhost:6083/watch.html
# ThinkPad / Caddy: https://cu-phone.hsv/watch.html → 127.0.0.1:6083
# RESET_FORCE_STOP_PACKAGES=com.instagram.android,com.zhiliaoapp.musically
# RECYCLE_CLEAR_PACKAGES=com.instagram.android,com.zhiliaoapp.musically

SESSION_TTL_SEC=600
# Parked (soft-released) seats are wiped after this idle period
PARKED_TTL_SEC=1800
# Display: ASPECT_RATIO + WIDTH (HEIGHT is derived). Examples: 16:9, 16:10, 4:3
# Explicit HEIGHT overrides the derived value only if you clear ASPECT_RATIO.
ASPECT_RATIO=16:10
WIDTH=1280
# HEIGHT=

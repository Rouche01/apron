# Copy to .env and adjust. Used by docker compose.

COMPUTER_API_TOKEN=dev-token
GATEWAY_PUBLIC_BASE=http://localhost:9000

# Per-env worker inventory (must be an existing file — Compose mounts it read-only).
# Desktop-only (default):
WORKER_INVENTORY_FILE=./gateway/workers.json
# Desktop + physical phone (requires COMPOSE_PROFILES=phone):
# WORKER_INVENTORY_FILE=./gateway/workers.with-phone.json
# COMPOSE_PROFILES=phone
# Desktop + cloud phone (Phone Harness; requires COMPOSE_PROFILES=phone-cloud):
# WORKER_INVENTORY_FILE=./gateway/workers.with-phone-cloud.json
# COMPOSE_PROFILES=phone-cloud
# PHONE_HARNESS_API_KEY=pck_…
# Optional: both physical + cloud — COMPOSE_PROFILES=phone,phone-cloud with the same inventory.
# ThinkPad / Caddy (.hsv HITL URLs):
#   cp gateway/workers.hsv.example.json gateway/workers.hsv.json
#   # edit vnc_url hostnames, then:
# WORKER_INVENTORY_FILE=./gateway/workers.hsv.json
# After up: curl -s -H "Authorization: Bearer $COMPUTER_API_TOKEN" http://localhost:9000/v1/seats | jq .

# Phone worker (profile "phone") — ADB must reach the device from this host (ThinkPad).
# First-time: enable Wireless debugging (or USB), then on the host:
#   adb connect 192.168.1.20:5555   # tap Allow / Authorize on the phone once
# Same ~/.android keys are mounted into phone-1 + scrcpy-web. After Allow, rebind via:
#   POST /v1/seats/phone1/bind  {"connect":"192.168.1.20:5555"}
# Boot defaults (optional if you only bind via the API):
# ADB_SERIAL=R5CY53CAB6N
# ADB_CONNECT=192.168.1.20:5555
# Phone Watch (scrcpy-web on Compose profile phone → host :6083).
# Prefer /watch.html so lease vnc_url auto-selects the bound serial (?udid=); / is the device picker.
# PHONE_HITL_URL=http://localhost:6083/watch.html
# ThinkPad / Caddy: https://cu-phone.hsv/watch.html → 127.0.0.1:6083
# SCRCPY_ADB_API_URL=http://scrcpy-web:8001
# RESET_FORCE_STOP_PACKAGES=com.instagram.android,com.zhiliaoapp.musically
# RECYCLE_CLEAR_PACKAGES=com.instagram.android,com.zhiliaoapp.musically

# Cloud phone (profile phone-cloud) — gateway CloudPhoneProvider / phone-harness.
# Dogfood: up → GET /v1/seats → POST /v1/sessions kind=phone → open vnc_url (watch_url)
#   → observe/action → DELETE ?recycle=true (teardown / stop billing).
# Soft park keeps the harness session; recycle / parked-idle tears it down.
# PHONE_HARNESS_API_KEY=pck_…
# PHONE_HARNESS_API_BASE=https://api.phone-harness.com
# PHONE_HARNESS_TIMEOUT_SEC=2400
# PHONE_HARNESS_PROFILE_ID=

SESSION_TTL_SEC=600
# Parked (soft-released) seats are wiped after this idle period
PARKED_TTL_SEC=1800

# Elastic burst (optional) — reserved seats stay on Compose; extras via k3s.
# See deploy/k3s/README.md and .cursor/plans/elastic_seats.plan.md
# SEAT_BURST_BACKEND=disabled
# DESKTOP_BURST_MAX=0
# PHONE_BURST_MAX=0
# PHONE_BURST_PROVIDER=phone-harness
# KUBECONFIG=
# SEAT_BURST_DESKTOP_IMAGE=computer-with-agent-worker:local
# SEAT_BURST_PHONE_IMAGE=computer-with-agent-phone:local
# GATEWAY_BURST_VNC_BASE=http://localhost:30080

# Display: ASPECT_RATIO + WIDTH (HEIGHT is derived). Examples: 16:9, 16:10, 4:3
# Explicit HEIGHT overrides the derived value only if you clear ASPECT_RATIO.
ASPECT_RATIO=16:10
WIDTH=1280
# HEIGHT=

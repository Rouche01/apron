# Copy to .env:  cp -n .env.example .env
# Default = two warm desktop seats. Phone / cloud / burst are optional (see below).

# --- Desktop (default — enough for README quick start) ---
COMPUTER_API_TOKEN=dev-token
GATEWAY_PUBLIC_BASE=http://localhost:9000
WORKER_INVENTORY_FILE=./gateway/workers.json

SESSION_TTL_SEC=600
# Soft-released seats are wiped after this idle period
PARKED_TTL_SEC=1800

# --- Optional: session recording journals (screenshots/actions; not video) ---
# Opt-in per lease: POST /v1/sessions {"record":true} … or set default below.
# Distinct from PARKED_TTL — archive survives park/recycle; TTL deletes old journals.
# RECORDING_DIR=/data/recordings
# RECORDING_TTL_SEC=604800
# RECORD_SESSIONS_DEFAULT=0
# RECORDING_MAX_FRAME_BYTES=2000000
# Hosted object storage (same /v1/recordings API) — docs/hosted.md
# RECORDING_BACKEND=local
# RECORDING_BACKEND=s3
# RECORDING_S3_BUCKET=
# RECORDING_S3_PREFIX=recordings
# RECORDING_S3_ENDPOINT=https://….r2.cloudflarestorage.com
# RECORDING_S3_REGION=auto
# RECORDING_S3_ACCESS_KEY=
# RECORDING_S3_SECRET_KEY=

# --- Optional: hosted soft tenancy (multi-customer API keys) ---
# Copy gateway/tenants.example.json → gateway/tenants.json; mount into the gateway.
# When set, Bearer must match a tenant key or COMPUTER_API_TOKEN (ops = all seats).
# Details: docs/hosted.md
# TENANTS_PATH=/etc/computer/tenants.json
# TENANTS_FILE=./gateway/tenants.json

# --- Optional: hosted Stripe billing (open signup → API key + seat claim) ---
# Requires TENANTS_PATH and a read-write tenants.json mount (drop :ro).
# Details: docs/hosted.md (Billing) · docs/hosted-ops.md (webhook)
# STRIPE_SECRET_KEY=sk_live_…   # or sk_test_… ; unset = billing routes 404
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_STARTER=price_…  # 1 desktop seat
# STRIPE_PRICE_PRO=price_…      # 2 desktop seats
# BILLING_SUCCESS_URL=https://www.example.com/signup/ok?sid={CHECKOUT_SESSION_ID}
# BILLING_CANCEL_URL=https://www.example.com/signup/cancel
# BILLING_PORTAL_RETURN_URL=https://www.example.com/account

# Display: ASPECT_RATIO + WIDTH (HEIGHT derived). Examples: 16:9, 16:10, 4:3
ASPECT_RATIO=16:10
WIDTH=1280
# HEIGHT=

# --- Optional: physical phone (Compose profile "phone") ---
# ADB must reach the device from the machine running Compose (USB or wireless).
# WORKER_INVENTORY_FILE=./gateway/workers.with-phone.json
# COMPOSE_PROFILES=phone
# First-time wireless: on the host, `adb connect HOST:5555` and tap Allow on the phone.
# Same ~/.android keys are mounted into phone-1 + scrcpy-web.
# Then rebind anytime: POST /v1/seats/phone1/bind  {"connect":"HOST:5555"}
# ADB_SERIAL=
# ADB_CONNECT=
# PHONE_HITL_URL=http://localhost:6083/watch.html
# SCRCPY_ADB_API_URL=http://scrcpy-web:8001
# RESET_FORCE_STOP_PACKAGES=
# RECYCLE_CLEAR_PACKAGES=
# Details: docs/profiles.md · AGENTS.md

# --- Optional: cloud phone (Compose profile "phone-cloud") ---
# WORKER_INVENTORY_FILE=./gateway/workers.with-phone-cloud.json
# COMPOSE_PROFILES=phone-cloud
# First time (reuses apron-phone:local from phone-1 Dockerfile):
#   docker compose --profile phone build phone-1

# Put the real key only in your local .env (never commit it).
# PHONE_HARNESS_API_KEY=pck_…
# PHONE_HARNESS_API_BASE=https://api.phone-harness.com
# PHONE_HARNESS_TIMEOUT_SEC=2400
# PHONE_HARNESS_PROFILE_ID=
# Both physical + cloud: COMPOSE_PROFILES=phone,phone-cloud (and a matching inventory file).
# Soft park keeps the vendor session; recycle / parked-idle tears it down (stops billing).
# Details: docs/profiles.md · AGENTS.md

# --- Optional: k3s lease burst (beyond reserved Compose seats) ---
# SEAT_BURST_BACKEND=disabled
# DESKTOP_BURST_MAX=0
# PHONE_BURST_MAX=0
# PHONE_BURST_PROVIDER=phone-harness
# PHONE_WARM_SPAWN_MAX=0
# KUBECONFIG=
# SEAT_BURST_DESKTOP_IMAGE=apron-worker:local
# SEAT_BURST_PHONE_IMAGE=apron-phone:local
# GATEWAY_BURST_VNC_BASE=http://localhost:30080
# Details: deploy/k3s/README.md · docs/profiles.md

# --- Optional: reverse-proxy / LAN hostnames for Watch URLs ---
# Copy gateway/workers.hsv.example.json → e.g. gateway/workers.local.json, edit vnc_url
# hostnames, then set WORKER_INVENTORY_FILE to that path. Bind Compose ports to
# loopback and put Caddy (or similar) in front if exposing beyond localhost.
# See AGENTS.md (ThinkPad / Caddy notes) for a worked example.
#
# Hosted desktop (public API + Watch): copy gateway/workers.hosted.example.json,
# set GATEWAY_PUBLIC_BASE=https://api.example.com, and use
# deploy/hosted-caddy.example.caddyfile — details in docs/hosted.md.

# Rendered by gateway WorkerFactory (k3s). Placeholders: {{JOB_NAME}} {{NAMESPACE}} {{IMAGE}} {{SEAT_ID}}
# Phone burst worker: ADB client only (ALLOW_EMPTY_DEVICE). Watch URL comes from CloudPhoneProvider after lease.
apiVersion: batch/v1
kind: Job
metadata:
  name: {{JOB_NAME}}
  namespace: {{NAMESPACE}}
  labels:
    app.kubernetes.io/name: computer-phone-burst
    app.kubernetes.io/part-of: computer-with-agent
    computer.burst/seat: "{{SEAT_ID}}"
    computer.burst/kind: phone
spec:
  ttlSecondsAfterFinished: 120
  backoffLimit: 0
  template:
    metadata:
      labels:
        app.kubernetes.io/name: computer-phone-burst
        computer.burst/seat: "{{SEAT_ID}}"
        computer.burst/kind: phone
        computer.burst/job: "{{JOB_NAME}}"
    spec:
      restartPolicy: Never
      containers:
        - name: worker
          image: {{IMAGE}}
          imagePullPolicy: IfNotPresent
          ports:
            - name: control
              containerPort: 8000
          env:
            - name: PORT
              value: "8000"
            - name: ALLOW_EMPTY_DEVICE
              value: "1"
            - name: HOME
              value: /root
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
            limits:
              memory: "1Gi"
          readinessProbe:
            httpGet:
              path: /health
              port: control
            initialDelaySeconds: 5
            periodSeconds: 5
            failureThreshold: 36
---
apiVersion: v1
kind: Service
metadata:
  name: {{JOB_NAME}}
  namespace: {{NAMESPACE}}
  labels:
    computer.burst/seat: "{{SEAT_ID}}"
    computer.burst/kind: phone
spec:
  selector:
    computer.burst/job: "{{JOB_NAME}}"
  ports:
    - name: control
      port: 8000
      targetPort: control

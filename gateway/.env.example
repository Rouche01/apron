# Gateway env (Compose sets most of these). Inventory is a JSON file, not URL lists.

COMPUTER_API_TOKEN=dev-token
GATEWAY_PUBLIC_BASE=http://localhost:9000
WORKER_INVENTORY_PATH=/etc/computer/workers.json
REQUIRE_WORKER_INVENTORY=1
SESSION_TTL_SEC=600
PARKED_TTL_SEC=1800

# Legacy (only if WORKER_INVENTORY_PATH is unset): comma-separated parallel lists, all desktop.
# WORKER_URLS=http://worker-1:8000,http://worker-2:8000
# WORKER_VNC_URLS=http://localhost:6081/vnc.html?autoconnect=1&resize=scale,http://localhost:6082/vnc.html?autoconnect=1&resize=scale

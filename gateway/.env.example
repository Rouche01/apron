# Gateway container env (Compose usually sets these).
# Do not put real API keys here — copy patterns into the repo-root .env instead.

COMPUTER_API_TOKEN=dev-token
GATEWAY_PUBLIC_BASE=http://localhost:9000
WORKER_INVENTORY_PATH=/etc/computer/workers.json
REQUIRE_WORKER_INVENTORY=1
SESSION_TTL_SEC=600
PARKED_TTL_SEC=1800

# Session recording journals (Compose volume → /data/recordings)
RECORDING_DIR=/data/recordings
RECORDING_TTL_SEC=604800
RECORD_SESSIONS_DEFAULT=0
RECORDING_MAX_FRAME_BYTES=2000000

# Cloud phone (optional): set the real key only in Compose/.env, never commit it.
# PHONE_HARNESS_API_KEY=pck_…

# Legacy (only if WORKER_INVENTORY_PATH is unset): comma-separated parallel lists, all desktop.
# WORKER_URLS=http://worker-1:8000,http://worker-2:8000
# WORKER_VNC_URLS=http://localhost:6081/vnc.html?autoconnect=1&resize=scale,http://localhost:6082/vnc.html?autoconnect=1&resize=scale

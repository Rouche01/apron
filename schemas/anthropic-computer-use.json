{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Computer Runtime — Anthropic computer-use shaped actions",
  "description": "Maps common Anthropic computer-use action names to this gateway's POST /v1/sessions/{id}/action body. Your host still runs the agent loop: model emits an action → you HTTP-execute → return screenshot. Desktop display defaults 1280×800; phone seats use device screenshot geometry (lease kind=phone). Phone-only gateway types: swipe, long_press, launch; key text uses Android names (back|home|recents).",
  "display_width_px": 1280,
  "display_height_px": 800,
  "tool_declaration_example": {
    "type": "computer_20241022",
    "name": "computer",
    "display_width_px": 1280,
    "display_height_px": 800,
    "display_number": 1
  },
  "session": {
    "lease": "POST /v1/sessions",
    "screenshot": "GET /v1/sessions/{session_id}/screenshot",
    "action": "POST /v1/sessions/{session_id}/action",
    "release": "DELETE /v1/sessions/{session_id}"
  },
  "actions": [
    {
      "anthropic": { "action": "screenshot" },
      "http": {
        "method": "GET",
        "path": "/v1/sessions/{session_id}/screenshot"
      },
      "notes": "Return the gateway JSON { image: <base64 png> } to the model as an image block."
    },
    {
      "anthropic": { "action": "left_click", "coordinate": ["$x", "$y"] },
      "gateway": { "type": "click", "x": "$x", "y": "$y" }
    },
    {
      "anthropic": { "action": "double_click", "coordinate": ["$x", "$y"] },
      "gateway": { "type": "double_click", "x": "$x", "y": "$y" }
    },
    {
      "anthropic": { "action": "right_click", "coordinate": ["$x", "$y"] },
      "gateway": { "type": "right_click", "x": "$x", "y": "$y" }
    },
    {
      "anthropic": { "action": "mouse_move", "coordinate": ["$x", "$y"] },
      "gateway": { "type": "move", "x": "$x", "y": "$y" }
    },
    {
      "anthropic": { "action": "type", "text": "$text" },
      "gateway": { "type": "type", "text": "$text" }
    },
    {
      "anthropic": { "action": "key", "text": "$key" },
      "gateway": { "type": "key", "text": "$key" },
      "notes": "Use xdotool key names (Return, ctrl+l). Map Anthropic key combos accordingly."
    },
    {
      "anthropic": {
        "action": "scroll",
        "coordinate": ["$x", "$y"],
        "scroll_direction": "$direction",
        "scroll_amount": "$amount"
      },
      "gateway": {
        "type": "scroll",
        "direction": "$direction",
        "amount": "$amount",
        "x": "$x",
        "y": "$y"
      },
      "notes": "Desktop: optional move first. Phone: mid-screen (or x,y) vertical swipe. direction must be up|down."
    },
    {
      "anthropic": {
        "action": "left_click_drag",
        "start_coordinate": ["$x1", "$y1"],
        "coordinate": ["$x2", "$y2"]
      },
      "gateway": {
        "type": "swipe",
        "x1": "$x1",
        "y1": "$y1",
        "x2": "$x2",
        "y2": "$y2",
        "duration_ms": "$duration_ms"
      },
      "notes": "Phone seats: map drag to swipe. Desktop still unsupported as mouse drag."
    },
    {
      "extension": { "action": "long_press", "coordinate": ["$x", "$y"] },
      "gateway": {
        "type": "long_press",
        "x": "$x",
        "y": "$y",
        "duration_ms": "$duration_ms"
      },
      "notes": "Phone-only extension (not stock Anthropic computer-use)."
    },
    {
      "extension": { "action": "launch", "package": "$package", "uri": "$uri" },
      "gateway": {
        "type": "launch",
        "package": "$package",
        "uri": "$uri"
      },
      "notes": "Phone-only: am start / VIEW intent."
    },
    {
      "extension": { "action": "android_key", "text": "$key" },
      "gateway": { "type": "key", "text": "$key" },
      "notes": "Phone: back|home|recents|enter|delete|escape or numeric keycode."
    }
  ],
  "unsupported_in_v0": [
    "middle_click",
    "triple_click",
    "cursor_position",
    "hold_key",
    "wait"
  ],
  "unsupported_desktop_only": ["left_click_drag"],
  "phone_notes": "Lease with {\"kind\":\"phone\"}. Prefer swipe/long_press/launch over desktop chords. right_click maps to long_press on the phone worker."
}

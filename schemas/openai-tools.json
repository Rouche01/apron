{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Computer Runtime — OpenAI-compatible function tools",
  "description": "Pass these as tools[].function (or Chat Completions tools) to any OpenAI-compatible model. Your agent must hold a leased session_id and map each call to the gateway HTTP API. Desktop default display 1280×800; phone uses device screenshot pixels (lease with kind=phone).",
  "session": {
    "lease": "POST /v1/sessions",
    "lease_body_kind": "desktop | phone (default desktop)",
    "screenshot": "GET /v1/sessions/{session_id}/screenshot",
    "action": "POST /v1/sessions/{session_id}/action",
    "heartbeat": "POST /v1/sessions/{session_id}/heartbeat",
    "release": "DELETE /v1/sessions/{session_id}"
  },
  "seat_kinds": {
    "desktop": ["computer_screenshot", "computer_click", "computer_double_click", "computer_right_click", "computer_move", "computer_type", "computer_key", "computer_scroll"],
    "phone": ["computer_screenshot", "computer_click", "computer_long_press", "computer_swipe", "computer_scroll", "computer_type", "computer_key", "computer_launch"]
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "computer_screenshot",
        "description": "Capture the current desktop as a PNG. Returns base64 image data from the gateway.",
        "parameters": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "http": {
        "method": "GET",
        "path": "/v1/sessions/{session_id}/screenshot"
      }
    },
    {
      "type": "function",
      "function": {
        "name": "computer_click",
        "description": "Desktop: move to (x, y) and left-click. Phone: tap at (x, y). Coordinates are screenshot pixels from the top-left.",
        "parameters": {
          "type": "object",
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 }
          },
          "required": ["x", "y"],
          "additionalProperties": false
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{session_id}/action",
        "body": { "type": "click", "x": "$x", "y": "$y" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "computer_double_click",
        "description": "Move to (x, y) and double left-click.",
        "parameters": {
          "type": "object",
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 }
          },
          "required": ["x", "y"],
          "additionalProperties": false
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{session_id}/action",
        "body": { "type": "double_click", "x": "$x", "y": "$y" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "computer_right_click",
        "description": "Move to (x, y) and right-click.",
        "parameters": {
          "type": "object",
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 }
          },
          "required": ["x", "y"],
          "additionalProperties": false
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{session_id}/action",
        "body": { "type": "right_click", "x": "$x", "y": "$y" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "computer_move",
        "description": "Move the mouse pointer to (x, y) without clicking.",
        "parameters": {
          "type": "object",
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 }
          },
          "required": ["x", "y"],
          "additionalProperties": false
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{session_id}/action",
        "body": { "type": "move", "x": "$x", "y": "$y" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "computer_type",
        "description": "Type text into the focused window (Unicode string).",
        "parameters": {
          "type": "object",
          "properties": {
            "text": { "type": "string", "minLength": 1 }
          },
          "required": ["text"],
          "additionalProperties": false
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{session_id}/action",
        "body": { "type": "type", "text": "$text" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "computer_key",
        "description": "Desktop: xdotool key/chord (Return, ctrl+l). Phone: Android key name (back, home, recents, enter, delete, escape) or numeric keycode.",
        "parameters": {
          "type": "object",
          "properties": {
            "key": { "type": "string", "minLength": 1 }
          },
          "required": ["key"],
          "additionalProperties": false
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{session_id}/action",
        "body": { "type": "key", "text": "$key" }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "computer_scroll",
        "description": "Desktop: scroll wheel repeats. Phone: vertical swipe near mid-screen (or x,y). direction up|down; amount scales distance (default 3).",
        "parameters": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "string",
              "enum": ["up", "down"],
              "default": "down"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 3
            },
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{session_id}/action",
        "body": {
          "type": "scroll",
          "direction": "$direction",
          "amount": "$amount",
          "x": "$x",
          "y": "$y"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "computer_long_press",
        "description": "Phone: long-press at (x, y). Optional duration_ms (default ~800).",
        "parameters": {
          "type": "object",
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "duration_ms": { "type": "integer", "minimum": 1, "maximum": 10000 }
          },
          "required": ["x", "y"],
          "additionalProperties": false
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{session_id}/action",
        "body": {
          "type": "long_press",
          "x": "$x",
          "y": "$y",
          "duration_ms": "$duration_ms"
        }
      },
      "seat_kinds": ["phone"]
    },
    {
      "type": "function",
      "function": {
        "name": "computer_swipe",
        "description": "Phone: swipe from (x1,y1) to (x2,y2). Optional duration_ms (default ~300).",
        "parameters": {
          "type": "object",
          "properties": {
            "x1": { "type": "integer", "minimum": 0 },
            "y1": { "type": "integer", "minimum": 0 },
            "x2": { "type": "integer", "minimum": 0 },
            "y2": { "type": "integer", "minimum": 0 },
            "duration_ms": { "type": "integer", "minimum": 1, "maximum": 10000 }
          },
          "required": ["x1", "y1", "x2", "y2"],
          "additionalProperties": false
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{session_id}/action",
        "body": {
          "type": "swipe",
          "x1": "$x1",
          "y1": "$y1",
          "x2": "$x2",
          "y2": "$y2",
          "duration_ms": "$duration_ms"
        }
      },
      "seat_kinds": ["phone"]
    },
    {
      "type": "function",
      "function": {
        "name": "computer_launch",
        "description": "Phone: launch an app by package name and/or open a VIEW uri (deep link / https).",
        "parameters": {
          "type": "object",
          "properties": {
            "package": { "type": "string", "minLength": 1 },
            "uri": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "http": {
        "method": "POST",
        "path": "/v1/sessions/{session_id}/action",
        "body": {
          "type": "launch",
          "package": "$package",
          "uri": "$uri"
        }
      },
      "seat_kinds": ["phone"]
    }
  ]
}
